# Environment for every shell (sh, bash, zsh). POSIX; safe to source more than once.
# Sourced by ~/.profile, ~/.zprofile, ~/.bashrc and ~/.zshrc.

# Move $1 to the front of PATH (dropping any existing copy), if it is a directory.
# Moving rather than skipping matters on macOS, where path_helper puts /usr/bin first.
path_prepend() {
    [ -d "$1" ] || return 0
    _pp=":$PATH:"
    while case "$_pp" in *":$1:"*) true ;; *) false ;; esac; do
        _pp="${_pp%%:"$1":*}:${_pp#*:"$1":}"
    done
    _pp="${_pp#:}"
    _pp="${_pp%:}"
    PATH="$1${_pp:+:$_pp}"
    unset _pp
}

# Homebrew: Apple Silicon, Intel macOS, then Linuxbrew
for _brew in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [ -x "$_brew/bin/brew" ] && { [ "$_brew" != /usr/local ] || [ "$(uname -s)" = Darwin ]; }; then
        export HOMEBREW_PREFIX="$_brew"
        path_prepend "$_brew/sbin"
        path_prepend "$_brew/bin"
        break
    fi
done
unset _brew
export HOMEBREW_BUNDLE_FILE={{ joinPath .chezmoi.workingTree "setup/Brewfile" | quote }}

path_prepend /usr/local/sbin
path_prepend "$HOME/.yarn/bin"
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.bin"
export PATH

if command -v nvim >/dev/null 2>&1; then
    EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
    EDITOR=vim
else
    EDITOR='vi'
fi
export EDITOR VISUAL="$EDITOR"

if [ -z "${JAVA_HOME-}" ]; then
    if [ -x /usr/libexec/java_home ]; then
        JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null)" || JAVA_HOME=
    elif [ -d /usr/lib/jvm/default-java ]; then # Debian/Ubuntu
        JAVA_HOME=/usr/lib/jvm/default-java
    elif [ -d /usr/lib/jvm/java ]; then # Fedora
        JAVA_HOME=/usr/lib/jvm/java
    fi
    if [ -n "$JAVA_HOME" ]; then export JAVA_HOME; else unset JAVA_HOME; fi
fi

for _sdk in "$HOME/Library/Android/sdk" "$HOME/Android/Sdk"; do
    [ -d "$_sdk" ] && export ANDROID_SDK_ROOT="$_sdk" && break
done
unset _sdk

if [ -f "$HOME/.ghcup/env" ]; then . "$HOME/.ghcup/env"; fi
